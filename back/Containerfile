FROM alpine-builder AS builder

RUN apk add --no-cache \
        mariadb-connector-c-dev

ADD *.h *.cpp ${SOURCE_DIR}/

#RUN mariadb_config
RUN make -C ${SOURCE_DIR} -j -k server \
        CXXFLAGS="${CXXFLAGS} -I/usr/include/mysql -I/usr/include/mysql/mysql" \
        LDFLAGS="${LDFLAGS} -L/usr/lib/ -lmariadb -lz -ldl -lssl -lcrypto"

# --------------------------------------------------------------------------------
FROM scratch

COPY --from=builder /sources/server /server

#RUN ldd /server or /sources/server in alpine image
COPY --from=builder /usr/lib/libmariadb* /usr/lib/libstdc++* /usr/lib/libgcc* /usr/lib/
COPY --from=builder /lib/ld-musl* /lib/libz* /lib/libssl* /lib/libcrypto* /lib/

ENV LD_LIBRARY_PATH=/usr/lib:/lib

CMD ["/server"]
