FROM alpine-builder AS builder

ADD *.h *.cpp ${SOURCE_DIR}/

RUN make -C ${SOURCE_DIR} -j -k server LDFLAGS="-lavformat -lavcodec -lavdevice -lavfilter -lswresample -lswscale -lavutil -lpng -lz" \
    && strip ${SOURCE_DIR}/server

# --------------------------------------------------------------------------------
FROM scratch

COPY --from=builder /sources/server /server
ADD static/ /static/
ADD templates/ /templates/

CMD ["/server"]
