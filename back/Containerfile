FROM alpine-common AS common

RUN apk add --no-cache \
    gcc \
    yasm

ADD *.h *.cpp Makefile ${SOURCE_DIR}/back/

# configure zlib and build it because it is a dependency of libpng configure
RUN ${SOURCE_DIR}/configure --zlib && make -C ${SOURCE_DIR}/back -j zlib && \
    ${SOURCE_DIR}/configure --libpng --ffmpeg && make -C ${SOURCE_DIR}/back DEBUG=0 -j all \
    && strip ${SOURCE_DIR}/bin/release/back/server

# --------------------------------------------------------------------------------
FROM scratch

COPY --from=common /sources/bin/release/back/server /server
ADD static/ /static/
ADD templates/ /templates/

CMD ["/server"]
