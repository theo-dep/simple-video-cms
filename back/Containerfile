FROM alpine-builder AS builder

RUN apk add --no-cache \
        mariadb-connector-c-dev

ADD *.h *.cpp ${SOURCE_DIR}/

RUN make -C ${SOURCE_DIR} -j -k server CXXFLAGS="${CXXFLAGS}" LDFLAGS="-lmysqlclient -lz -lzstd -lssl -lcrypto -lresolv -lm"

# --------------------------------------------------------------------------------
FROM scratch

COPY --from=builder /sources/server /server

CMD ["/server"]
