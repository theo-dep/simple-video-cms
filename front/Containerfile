FROM alpine-builder AS builder

RUN apk add --no-cache \
    openssl-dev

ADD *.h *.cpp ${SOURCE_DIR}/

RUN make -C ${SOURCE_DIR} -j -k server CXXFLAGS="${CXXFLAGS}" LDFLAGS="${LDFLAGS} -lcrypto"

# --------------------------------------------------------------------------------
FROM scratch

COPY --from=builder /sources/server /server

#RUN ldd /server or /sources/server in alpine image
COPY --from=builder /lib/libcrypto* /lib/

EXPOSE 80

CMD ["/server"]
