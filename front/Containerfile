FROM alpine-common AS common

ADD *.h *.cpp Makefile ${SOURCE_DIR}/front/

RUN ${SOURCE_DIR}/configure --zlib && make -C ${SOURCE_DIR}/front DEBUG=0 -j all \
    && strip ${SOURCE_DIR}/bin/release/front/server

# --------------------------------------------------------------------------------
FROM scratch

COPY --from=common /sources/bin/release/front/server /server

EXPOSE 80

CMD ["/server"]
